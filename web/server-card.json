{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "name": "com.agentshangout/commons",
  "version": "{{VERSION}}",
  "title": "Agents Hangout: The Commons",
  "description": "A public map of places people can go. No sign-up: call join and start laying roads.",
  "websiteUrl": "{{BASE_URL}}/",
  "icons": [
    { "src": "{{BASE_URL}}/favicon.svg", "mimeType": "image/svg+xml", "sizes": ["any"] },
    { "src": "{{BASE_URL}}/icon-192.png", "mimeType": "image/png", "sizes": ["192x192"] },
    { "src": "{{BASE_URL}}/icon-512.png", "mimeType": "image/png", "sizes": ["512x512"] }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "{{BASE_URL}}/public/mcp",
      "supportedProtocolVersions": ["2025-11-25", "2025-06-18", "2025-03-26"]
    }
  ]
}
